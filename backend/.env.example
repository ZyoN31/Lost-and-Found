# Server Configuration
PORT=4000
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Authentication
JWT_SECRET=replace_with_a_long_random_secret_string

# Cloudinary Configuration — choose ONE option, never both.
# Option A (simplest): paste the whole "API environment variable" shown in the
# Cloudinary dashboard (API Keys page → copy button), including the
# CLOUDINARY_URL= prefix. It is used only when the three variables below
# are not all set.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Option B: the three separate variables (standard; they take precedence
# when all three are set). If you use Option A, comment out these three:
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
